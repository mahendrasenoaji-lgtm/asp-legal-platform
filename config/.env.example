# ---------------------------------------------------------------------------
# ASP Legal Intelligence Platform — environment variables
# Copy to .env.local for development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL=https://asplawyer.co.id
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://user:password@host:5432/asp?sslmode=require
DATABASE_POOL_MAX=10

# CMS (decide Sanity vs Payload in Phase 4; keep only the block you use)
CMS_PROJECT_ID=
CMS_DATASET=production
CMS_READ_TOKEN=
CMS_WEBHOOK_SECRET=

# Object storage (S3-compatible) — intake uploads are a private bucket
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_MEDIA=asp-media
S3_BUCKET_INTAKE=asp-intake-private

# Malware scanning
CLAMAV_HOST=
CLAMAV_PORT=3310

# Email (intake notifications + acknowledgement)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
INTAKE_NOTIFY_TO=office@asplawyer.co.id

# Auth (admin)
AUTH_SECRET=
AUTH_URL=https://asplawyer.co.id/admin
AUTH_MFA_REQUIRED=true

# Rate limiting / cache
REDIS_URL=

# Analytics — loaded only after consent
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# Search (if Meilisearch is chosen over PostgreSQL FTS)
MEILI_HOST=
MEILI_MASTER_KEY=
